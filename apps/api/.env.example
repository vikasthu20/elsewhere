# SQLite for local development (no external database server required)
DATABASE_URL=sqlite:///./elsewhere.db

# If using a local PostgreSQL server or Docker instead, uncomment:
# DATABASE_URL=postgresql+psycopg://elsewhere:change-me-local-only@localhost:5432/elsewhere

SECRET_KEY=replace-with-a-long-random-secret-before-running
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
UPLOAD_DIR=./uploads
